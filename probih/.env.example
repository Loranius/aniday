# Supabase project (Project Settings → API). The anon key is public by design;
# data is protected by Row Level Security. Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: map tiles. Defaults to CARTO dark basemap (OSM data, attribution shown).
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
